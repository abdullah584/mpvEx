<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

  <!-- Background (full-bleed, so no separate background layer is needed) -->
  <path
      android:pathData="M0,0h512v512h-512z"
      android:fillColor="#07130F"/>

  <!-- Soft green glow -->
  <path android:pathData="M256,26 a230,230 0 1,0 0,460 a230,230 0 1,0 0,-460z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="radial"
          android:centerX="256"
          android:centerY="256"
          android:gradientRadius="230">
        <item android:offset="0" android:color="#6610B981"/>
        <item android:offset="1" android:color="#0010B981"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Waveform bars (lime to teal gradient) -->
  <path android:pathData="M110,231 a10,10 0 0 1 20,0 v50 a10,10 0 0 1 -20,0 z
                          M146,206 a10,10 0 0 1 20,0 v100 a10,10 0 0 1 -20,0 z
                          M182,181 a10,10 0 0 1 20,0 v150 a10,10 0 0 1 -20,0 z
                          M310,181 a10,10 0 0 1 20,0 v150 a10,10 0 0 1 -20,0 z
                          M346,206 a10,10 0 0 1 20,0 v100 a10,10 0 0 1 -20,0 z
                          M382,231 a10,10 0 0 1 20,0 v50 a10,10 0 0 1 -20,0 z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="100"
          android:startY="0"
          android:endX="412"
          android:endY="0">
        <item android:offset="0" android:color="#A3E635"/>
        <item android:offset="1" android:color="#14B8A6"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Center play triangle -->
  <path
      android:pathData="M230,216 V296 L284,256 Z"
      android:fillColor="#FFFFFF"
      android:strokeColor="#FFFFFF"
      android:strokeWidth="20"
      android:strokeLineJoin="round"/>
</vector>
